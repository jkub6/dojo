# Auto-generated by dojo - DO NOT EDIT MANUALLY
# Source: [PROJECT_ROOT]/dojo.yaml

ninja_required_version = 1.3

# Resource pools prevent CPU/memory saturation
pool test_pool
  depth = 1

# Rules
rule regenerate
  command = PYTHONPATH=[DOJO_ROOT]/src [PYTHON_BIN] -m dojo build -c [PROJECT_ROOT]/dojo.yaml
  description = ⚙️  REGENERATE build.ninja
  generator = 1

build [PROJECT_ROOT]/_build/build.ninja: regenerate [PROJECT_ROOT]/dojo.yaml

rule compile
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir [PROJECT_ROOT]/_build --cwd [PROJECT_ROOT]/_build -- [TOOL_PANDOC] {in_abs} $defaults -t json -o {out_abs} -M depfile={out_abs}.d -M target={out_abs} -V root={root_val} -M root={root_val} --resource-path=.:{in_abs_dir} --lua-filter [DOJO_ROOT]/src/dojo/resources/dependencies.lua
  description = 🧠 COMPILE $in
  pool = test_pool
  depfile = $out.d
  deps = gcc

rule render
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir {out_abs_dir} --cwd {out_abs_dir} -- [TOOL_PANDOC] {in_abs} $defaults -o {out_abs} -V root={root_val} -M root={root_val} -M dojo-rel-src-dir={rel_src_dir} --pdf-engine-opt=--root=[PROJECT_ROOT]/content --lua-filter [DOJO_ROOT]/src/dojo/resources/fix_typst_csl.lua --resource-path=.:{in_abs_dir}:{src_dir_val} --extract-media=media -M dojo-document-stem=$dojo_stem
  description = 🎨 RENDER $out

rule copy
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir {out_abs_dir} [PY_COPY] {in_abs} {out_abs}
  description = 📂 COPY $out

rule minify
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir {out_abs_dir} -- [TOOL_MINIFY] --html-keep-document-tags --html-keep-end-tags -q $args -o {out_abs} {in_abs}
  description = ⚡ MINIFY $out

rule ghostscript
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir {out_abs_dir} -- [TOOL_GS] -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dPDFSETTINGS=/ebook -dNOPAUSE -dQUIET -dBATCH -dSAFER $args -sOutputFile={out_abs} {in_abs}
  description = 🗜️  COMPRESS $out

rule decktape
  command = [DOJO_WRAP] --path-env "[TOOL_PATHS]" --in-file $in_shell --out-file $out_shell --src-dir [PROJECT_ROOT]/content --out-dir [PROJECT_ROOT]/_site --build-dir [PROJECT_ROOT]/_build  --ensure-dir {out_abs_dir} --serve-dir {out_dir} -- [TOOL_DECKTAPE] reveal $args {url} {out_abs}
  description = 📸 DECKTAPE $out

rule stamp
  command = [PYTHON_BIN] -c 'from pathlib import Path; Path("$out").touch()'
  description = 📌 STAMP $out

# Source: [PROJECT_ROOT]/content/index.md
build [PROJECT_ROOT]/_build/index.json: compile [PROJECT_ROOT]/content/index.md
  in_shell = [PROJECT_ROOT]/content/index.md
  out_shell = [PROJECT_ROOT]/_build/index.json

build [PROJECT_ROOT]/_site/index.html: render [PROJECT_ROOT]/_build/index.json | [PROJECT_ROOT]/defaults/page.yaml
  defaults = -d$ [PROJECT_ROOT]/defaults/page.yaml
  in_shell = [PROJECT_ROOT]/_build/index.json
  out_shell = [PROJECT_ROOT]/_site/index.html
  dojo_stem = index

