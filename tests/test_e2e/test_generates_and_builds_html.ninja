# Auto-generated by dojo - DO NOT EDIT MANUALLY
# Source: [PROJECT_ROOT]/dojo.yaml

ninja_required_version = 1.3

# Resource pools prevent CPU/memory saturation
pool test_pool
  depth = 1

# Rules
rule regenerate
  command = env PATH="[TOOL_PATHS]:$$PATH" dojo build -c [PROJECT_ROOT]/dojo.yaml
  description = ⚙️  REGENERATE build.ninja
  generator = 1

build [PROJECT_ROOT]/_build/build.ninja: regenerate [PROJECT_ROOT]/dojo.yaml

rule compile
  command = in_abs=$$(realpath $in_shell) && out_abs=$$(realpath -m $out_shell) && root_val=$$(realpath -m --relative-to="$$(dirname "$$out_abs")" [PROJECT_ROOT]/_site) && mkdir -p [PROJECT_ROOT]/_build && cd [PROJECT_ROOT]/_build && env PATH="[TOOL_PATHS]:$$PATH" [TOOL_PANDOC] "$$in_abs" $defaults -t json -o "$$out_abs" -M depfile="$$out_abs.d" -M target="$$out_abs" -V root=$$root_val -M root=$$root_val --resource-path=.:"$$(dirname "$$in_abs")" --lua-filter [DOJO_ROOT]/src/dojo/resources/dependencies.lua
  description = 🧠 COMPILE $in
  pool = test_pool
  depfile = $out.d
  deps = gcc

rule render
  command = in_abs=$$(realpath $in_shell) && out_abs=$$(realpath -m $out_shell) && root_val=$$(realpath -m --relative-to="$$(dirname "$$out_abs")" [PROJECT_ROOT]/_site) && out_abs_dir=$$(dirname "$$out_abs") && mkdir -p "$$out_abs_dir" && cd "$$out_abs_dir" && env PATH="[TOOL_PATHS]:$$PATH" [TOOL_PANDOC] "$$in_abs" $defaults -o "$$out_abs" -V root=$$root_val -M root=$$root_val -M dojo-rel-src-dir="$$(realpath -m --relative-to=[PROJECT_ROOT]/_build "$$(dirname "$$in_abs")")" --pdf-engine-opt=--root=[PROJECT_ROOT]/content --lua-filter [DOJO_ROOT]/src/dojo/resources/fix_typst_csl.lua --resource-path=.:"$$(dirname "$$in_abs")":"$$(realpath -m [PROJECT_ROOT]/content/"$$(realpath -m --relative-to=[PROJECT_ROOT]/_build "$$(dirname "$$in_abs")")")" --extract-media=media -M dojo-document-stem=$dojo_stem
  description = 🎨 RENDER $out

rule copy
  command = cp $in_shell $out_shell
  description = 📂 COPY $out

rule minify
  command = env PATH="[TOOL_PATHS]:$$PATH" [TOOL_MINIFY] --html-keep-document-tags --html-keep-end-tags -q $args -o $out_shell $in_shell
  description = ⚡ MINIFY $out

rule ghostscript
  command = env PATH="[TOOL_PATHS]:$$PATH" [TOOL_GS] -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dPDFSETTINGS=/ebook -dNOPAUSE -dQUIET -dBATCH -dSAFER $args -sOutputFile=$out_shell $in_shell
  description = 🗜️  COMPRESS $out

rule decktape
  command = env PATH="[TOOL_PATHS]:$$PATH" [TOOL_DECKTAPE] reveal $args $in_shell $out_shell
  description = 📸 DECKTAPE $out

# Source: [PROJECT_ROOT]/content/index.md
build [PROJECT_ROOT]/_build/index.json: compile [PROJECT_ROOT]/content/index.md
  in_shell = [PROJECT_ROOT]/content/index.md
  out_shell = [PROJECT_ROOT]/_build/index.json

build [PROJECT_ROOT]/_site/index.html: render [PROJECT_ROOT]/_build/index.json | [PROJECT_ROOT]/defaults/page.yaml
  defaults = -d$ [PROJECT_ROOT]/defaults/page.yaml
  in_shell = [PROJECT_ROOT]/_build/index.json
  out_shell = [PROJECT_ROOT]/_site/index.html
  dojo_stem = index

